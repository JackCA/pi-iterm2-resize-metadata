{
  "name": "pi-iterm2-resize-metadata",
  "version": "0.1.0",
  "description": "Preserve iTerm2 remote-host and current-directory metadata across Pi TUI redraws.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "Jack Anderson <JackCA@users.noreply.github.com>",
  "keywords": [
    "pi-package",
    "pi-extension",
    "iterm2",
    "tmux",
    "scp"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check extensions src tests package.json tsconfig.json biome.json",
    "hooks:install": "lefthook install",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "24.10.1",
    "lefthook": "2.1.10",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackCA/pi-iterm2-resize-metadata.git"
  },
  "bugs": {
    "url": "https://github.com/JackCA/pi-iterm2-resize-metadata/issues"
  },
  "homepage": "https://github.com/JackCA/pi-iterm2-resize-metadata#readme"
}
