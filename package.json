{
  "name": "pi-iterm2-resize-metadata",
  "version": "0.3.0",
  "description": "Preserve iTerm2 remote-host and current-directory metadata across Pi TUI redraws.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "author": "Jack Anderson <JackCA@users.noreply.github.com>",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "iterm2",
    "tmux",
    "scp"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "PUBLISHING.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check extensions src tests scripts package.json tsconfig.json biome.json commitlint.config.mjs release-please-config.json .release-please-manifest.json",
    "release:check": "node scripts/verify-release.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run release:check && npm run pack:check",
    "hooks:install": "lefthook install",
    "pack:check": "npm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./extensions/iterm2-resize-metadata/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@types/node": "24.10.1",
    "lefthook": "2.1.10",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JackCA/pi-iterm2-resize-metadata.git"
  },
  "bugs": {
    "url": "https://github.com/JackCA/pi-iterm2-resize-metadata/issues"
  },
  "homepage": "https://github.com/JackCA/pi-iterm2-resize-metadata#readme"
}
